[Desktop Entry]
Type=Application
Name=Recall
GenericName=File Search
Comment=Search your files by what's in them
Exec=@EXEC@ %U
Icon=io.github.pdstn12.Recall
Terminal=false
Categories=Utility;FileTools;
Keywords=search;find;files;photos;screenshots;pdf;video;audio;code;
StartupNotify=false
SingleMainWindow=true
DBusActivatable=false
Actions=Search;Settings;

[Desktop Action Search]
Name=Search
Exec=@EXEC@ --toggle

[Desktop Action Settings]
Name=Settings
Exec=@EXEC@ --settings
